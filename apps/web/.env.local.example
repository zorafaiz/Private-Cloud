# ===========================================
# Private Cloud - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# -------------------------------------------
# Supabase Configuration
# -------------------------------------------
# Your Supabase project URL (found in Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (found in Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -------------------------------------------
# Cloudflare R2 Configuration
# -------------------------------------------
# Your Cloudflare account ID (found in the dashboard URL)
CLOUDFLARE_ACCOUNT_ID=your-account-id

# R2 API Token credentials (created in R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Name of your R2 bucket
R2_BUCKET_NAME=private-cloud-files

# -------------------------------------------
# Cloudflare Workers URLs
# -------------------------------------------
# URL of the deployed shortener worker (API base)
SHORTENER_WORKER_URL=https://s.domainkamu.com

# Public short link origin (defaults to SHORTENER_WORKER_URL)
SHORTENER_PUBLIC_URL=https://s.domainkamu.com

# Shared secret — must match Worker secret: wrangler secret put AUTH_SECRET
SHORTENER_SECRET=your-shortener-secret

# URL of the deployed telegraph proxy worker
TELEGRAPH_WORKER_URL=https://telegraph-proxy.your-workers.dev

# -------------------------------------------
# Application
# -------------------------------------------
# The public URL of this web application
NEXT_PUBLIC_APP_URL=https://domainkamu.com
